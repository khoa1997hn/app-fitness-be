# Subscription Plans - PLUS
PLAN_PLUS_PRICE=
PLAN_PLUS_GOOGLE_ITEM_ID=
PLAN_PLUS_APPLE_PRODUCT_ID=

# Subscription Plans - ALL
PLAN_ALL_PRICE=
PLAN_ALL_GOOGLE_ITEM_ID=
PLAN_ALL_APPLE_PRODUCT_ID=

# Google Play Configuration (for LIAP package)
