# Apple App Store Configuration (for LIAP package)
APPSTORE_PASSWORD=
APPSTORE_PRIVATE_KEY_ID=
APPSTORE_PRIVATE_KEY=
APPSTORE_ISSUER_ID=
APPSTORE_BUNDLE_ID=

# Payment Currency
PAYMENT_CURRENCY=USD

# L5 swagger
L5_SWAGGER_GENERATE_ALWAYS=true

# Hệ thống phòng tập
# Thanh toán mock cấp gói miễn phí — không khai báo: bật ở mọi môi trường trừ production
# GYM_PAYMENT_MOCK_ENABLED=true
GYM_THERAPY_VALIDITY_DAYS=90
GYM_CANCEL_LOCK_HOURS=8
GYM_EXTRA_PEOPLE_PRICE=200000
GYM_OFF_PEAK_MORNING_END=08:00
GYM_OFF_PEAK_EVENING_START=23:00
GYM_REMINDER_HOURS=24
GYM_PACKAGE_EXPIRY_NOTICE_DAYS=7
GYM_EVENT_HOLD_MINUTES=30
GYM_REDLIGHT_PRICE=30000

# Ô chữ ký trên file điều khoản, tỉ lệ trang từ 0 đến 1, gốc trên trái
GYM_TERMS_SIGNATURE_PAGE=1
GYM_TERMS_SIGNATURE_X=0.55
GYM_TERMS_SIGNATURE_Y=0.72
GYM_TERMS_SIGNATURE_WIDTH=0.35
GYM_TERMS_SIGNATURE_HEIGHT=0.13
# Họ tên và ngày ký, in trên cùng trang với chữ ký
GYM_TERMS_SIGNER_X=0.55
GYM_TERMS_SIGNER_Y=0.855
GYM_TERMS_SIGNER_WIDTH=0.35
